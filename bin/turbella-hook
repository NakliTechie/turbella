#!/usr/bin/env node
// Hook shim: reads one Claude Code hook payload from stdin and forwards a
// single JSON-line envelope to the Turbella daemon's Unix socket, starting
// the daemon if none is running.
//
// Never fails loudly: every error is swallowed and the exit code is always 0.
// Delivery is awaited (an early exit dropped every event) but capped, and
// Claude Code runs these hooks async, so a tool call never waits on it.
//
// SessionStart runs synchronously instead: it makes sure the daemon is up and
// tells the person where the page is.
import { deliver } from '../src/socketWrite.js';

const HARD_EXIT_MS = 2500;
setTimeout(() => process.exit(0), HARD_EXIT_MS).unref();

let stdin = '';
process.stdin.on('data', (c) => { stdin += c; });
process.stdin.on('error', () => process.exit(0));
process.stdin.on('end', async () => {
  try {
    // Keep only what the daemon hashes or labels. Tool output, notification
    // text and everything else stay in this process.
    const { hook_event_name, session_id, tool_name, tool_input, error, error_message } = JSON.parse(stdin || '{}');
    const payload = { hook_event_name, session_id, tool_name, tool_input, error, error_message };
    const envelope = {
      type: payload.hook_event_name ?? 'unknown',
      session: payload.session_id ?? null,
      ts: Date.now(),
      agent: 'claude',
      payload,
    };
    if (envelope.type === 'SessionStart') {
      await deliver({ kind: 'ping' });
      const { readState } = await import('../src/daemon.js');
      // The socket opens before the page server, so the address can lag a moment.
      let st = readState();
      for (let i = 0; !st && i < 10; i++) { await new Promise((r) => setTimeout(r, 100)); st = readState(); }
      if (st) process.stdout.write(JSON.stringify({ systemMessage: `Turbella: http://127.0.0.1:${st.port}` }));
    } else {
      await deliver(envelope);
    }
  } catch { /* swallow: never fail loudly */ }
  process.exit(0);
});
