#!/usr/bin/env node
// Claude Code hook: reads one hook payload from stdin, hashes what names the
// call, and sends the daemon an event with hashes only. Starts the daemon if
// none runs. File bodies, prompts, tool output and notification text never
// leave this process.
//
// Never fails loudly: errors are swallowed and the exit code is always 0. The
// hooks run async (hooks/hooks.json), so a tool call never waits on this.
// SessionStart runs synchronously instead: it starts the daemon, opens the
// page when none is open (TURBELLA_OPEN=0 turns that off), and prints the
// page address for the person.
import { spawn } from 'node:child_process';
import { deliver } from '../src/socketWrite.js';
import { readState } from '../src/paths.js';
import { contentHash } from '../src/crypto.js';
import { hashToolInput, errorText } from '../src/event.js';

const HARD_EXIT_MS = 2500;
const MAX_STDIN = 16 * 1024 * 1024;
setTimeout(() => process.exit(0), HARD_EXIT_MS).unref();

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// Open the page in the default browser unless one is already connected.
async function openIfNoPage(url) {
  try {
    const { pages } = await (await fetch(`${url}/status`, { signal: AbortSignal.timeout(500) })).json();
    if (pages > 0) return;
  } catch { return; }
  const opener = process.platform === 'darwin' ? 'open' : 'xdg-open';
  const child = spawn(opener, [url], { stdio: 'ignore', detached: true });
  child.on('error', () => {});
  child.unref();
}
let stdin = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { stdin += c; if (stdin.length > MAX_STDIN) process.exit(0); });
process.stdin.on('error', () => process.exit(0));
process.stdin.on('end', async () => {
  try {
    const p = JSON.parse(stdin || '{}');
    const transcript = typeof p.transcript_path === 'string' ? p.transcript_path : null;
    if (p.hook_event_name === 'SessionStart') {
      await deliver({ kind: 'ping', transcript, session: p.session_id ?? null });
      let st = readState();
      for (let i = 0; !st && i < 10; i++) { await sleep(100); st = readState(); }
      if (st) {
        const url = `http://127.0.0.1:${st.port}`;
        if (process.env.TURBELLA_OPEN !== '0') await openIfNoPage(url);
        process.stdout.write(JSON.stringify({ systemMessage: `Turbella: ${url}` }));
      }
    } else {
      const failed = p.hook_event_name === 'PostToolUseFailure';
      const { sig, target } = failed
        ? { sig: await contentHash(errorText(p.error ?? p.error_message)), target: null }
        : await hashToolInput(p.tool_input);
      await deliver({
        type: p.hook_event_name ?? 'unknown',
        session: p.session_id ?? null,
        ts: Date.now(),
        agent: 'claude',
        tool: typeof p.tool_name === 'string' ? p.tool_name : null,
        sig, target, transcript,
      });
    }
  } catch { /* never fail loudly */ }
  process.exit(0);
});
