#!/usr/bin/env node
// Agent hook for Claude Code, Codex, Copilot, Cursor and Hermes (src/agents.js): reads one
// hook payload from stdin, hashes what names the call, and sends the daemon an
// event with hashes only. Starts the daemon if none runs. File bodies, prompts, tool output and notification text never
// leave this process.
//
// Never fails loudly: errors are swallowed and the exit code is always 0. Claude
// Code runs these hooks async (hooks/hooks.json). Other agents wait for each hook,
// so for them the hook hands the payload to a detached copy of itself
// (`--send`) and exits at once; hashing and delivery happen off the agent's path.
// SessionStart runs synchronously instead: it starts the daemon, opens the
// page when none is open (TURBELLA_OPEN=0 turns that off), and prints the
// page address for the person.
import { spawn } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { deliver } from '../src/socketWrite.js';
import { readState } from '../src/paths.js';
import { contentHash } from '../src/crypto.js';
import { hashToolInput, errorText } from '../src/event.js';
import { PROFILES, detectAgent, normalise } from '../src/agents.js';

const HARD_EXIT_MS = 2500;
const MAX_STDIN = 16 * 1024 * 1024;
setTimeout(() => process.exit(0), HARD_EXIT_MS).unref();

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// Open the page in the default browser unless one is already connected.
async function openIfNoPage(url) {
  try {
    const { pages } = await (await fetch(`${new URL(url).origin}/status`, { signal: AbortSignal.timeout(500) })).json();
    if (pages > 0) return;
  } catch { return; }
  const opener = process.platform === 'darwin' ? 'open' : 'xdg-open';
  const child = spawn(opener, [url], { stdio: 'ignore', detached: true });
  child.on('error', () => {});
  child.unref();
}
let stdin = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { stdin += c; if (stdin.length > MAX_STDIN) process.exit(0); });
process.stdin.on('error', () => process.exit(0));
process.stdin.on('end', async () => {
  try {
    const p = JSON.parse(stdin || '{}');
    const agent = detectAgent(p);
    const profile = PROFILES[agent];
    const n = normalise(p);
    if (n.event !== 'SessionStart' && agent !== 'claude' && !process.argv.includes('--send')) {
      const child = spawn(process.execPath, [fileURLToPath(import.meta.url), '--send', '--agent', agent],
        { detached: true, stdio: ['pipe', 'ignore', 'ignore'], env: process.env });
      child.on('error', () => process.exit(0));
      child.stdin.on('error', () => {});
      child.stdin.end(stdin, () => { child.unref(); process.exit(0); });
      return;
    }
    if (n.event === 'SessionStart') {
      await deliver({ kind: 'ping', transcript: n.transcript, session: n.session, run: process.env.TURBELLA_RUN ?? null });
      let st = readState();
      for (let i = 0; !st && i < 10; i++) { await sleep(100); st = readState(); }
      if (st) {
        const url = `http://127.0.0.1:${st.port}`;
        if (process.env.TURBELLA_OPEN !== '0') await openIfNoPage(`${url}/viz`);
        process.stdout.write(profile.greeting(url));
      }
    } else {
      const failed = profile.failed(n);
      const { sig, target } = failed
        ? { sig: await contentHash(errorText(profile.errorText(n))), target: null }
        : await hashToolInput(n.input);
      await deliver({
        type: failed ? 'PostToolUseFailure' : (n.event ?? 'unknown'),
        session: n.session,
        ts: Date.now(),
        agent,
        tool: typeof n.tool === 'string' ? n.tool : null,
        dur_ms: n.durMs,
        sig, target,
        transcript: n.transcript,
        call: typeof n.call === 'string' ? n.call.slice(0, 200) : null,
        // Set by `turbella run` for the agent it wraps, so its strip shows only this agent.
        run: process.env.TURBELLA_RUN ?? null,
      });
    }
  } catch { /* never fail loudly */ }
  process.exit(0);
});
