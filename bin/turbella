#!/usr/bin/env node
// Turbella CLI. `turbella start` runs the daemon in the foreground; every other
// command is a tool from src/manifest.js, run through the same handler the MCP
// server uses (src/tools.js).
//
//   turbella start
//   turbella status
//   turbella open
//   turbella overlay
//   turbella run [--] <agent> [args...]
//   turbella emit [--kind K] [--status S] [--tool T] [--session ID] [--agent NAME] [--payload JSON]
//   turbella replay <transcript.jsonl>
//   turbella install <claude|codex|copilot|cursor|hermes|opencode|pi|omp>
import { start, stop, AlreadyRunning } from '../src/daemon.js';
import { HANDLERS } from '../src/tools.js';

const USAGE = 'usage: turbella start | status | open | overlay | run <agent> [args...] | install <agent> | replay <file.jsonl> | emit [--kind K] [--status S] [--tool T] [--session ID] [--agent NAME] [--payload JSON]';
const [cmd, ...rest] = process.argv.slice(2);

// Parse `--key value` pairs; a bare word becomes a positional argument.
function parseArgs(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith('--')) { out._.push(a); continue; }
    const next = argv[i + 1];
    if (next !== undefined && !next.startsWith('--')) { out[a.slice(2)] = next; i++; }
    else out[a.slice(2)] = true;
  }
  return out;
}

// Map CLI words onto each tool's input object.
const INPUTS = {
  status: () => ({}),
  open: () => ({}),
  overlay: () => ({}),
  replay: (a) => ({ path: a._[0] }),
  install: (a) => ({ agent: a._[0] }),
  emit: (a) => {
    let payload;
    if (a.payload !== undefined) {
      try { payload = JSON.parse(a.payload); } catch { payload = a.payload; }
    }
    return { kind: a.kind, status: a.status, tool: a.tool, session: a.session, agent: a.agent, payload };
  },
};

async function runTool(name) {
  if (name === 'run') {
    // Everything after `run` is the agent's command line, its flags included.
    const command = rest[0] === '--' ? rest.slice(1) : rest;
    try {
      process.exit((await HANDLERS.run({ command })).exit);
    } catch (e) {
      console.error(`turbella run: ${e.message}`);
      process.exit(1);
    }
  }
  const input = INPUTS[name](parseArgs(rest));
  if (name === 'emit') {
    // emit never fails loudly and prints nothing: agents call it mid-task.
    try { await HANDLERS.emit(input); } catch {}
    process.exit(0);
  }
  try {
    const result = await HANDLERS[name](input);
    console.log(name === 'open' ? result.url : JSON.stringify(result, null, 2));
    process.exit(0);
  } catch (e) {
    console.error(`turbella ${name}: ${e.message}`);
    process.exit(1);
  }
}

if (cmd === 'start') {
  start().then(({ sockPath, port }) => {
    console.log(`turbella daemon: socket ${sockPath} · http://127.0.0.1:${port}`);
    // Clean up the socket and state file on a kill, so the next hook does not
    // read a dead daemon's address.
    for (const sig of ['SIGTERM', 'SIGINT']) {
      process.once(sig, () => { stop().finally(() => process.exit(0)); });
    }
  }).catch((e) => {
    if (e instanceof AlreadyRunning) {
      console.log(`turbella daemon already running · http://127.0.0.1:${e.state?.port ?? '?'}`);
      process.exit(0);
    }
    console.error(`turbella: ${e.message}`);
    process.exit(1);
  });
} else if (HANDLERS[cmd]) {
  runTool(cmd);
} else if (cmd === '--version' || cmd === '-v') {
  console.log('0.1.0');
} else {
  console.error(USAGE);
  process.exit(1);
}
